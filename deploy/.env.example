# 复制为 .env 后填真实值。不要提交含 Key 的 .env。
APP_ENV=production

# DeepSeek（辅导 / 路由）
DEEPSEEK_API_KEY=sk-xxx
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 陪伴 7B DPO 模型（本机 vLLM）
COMPANION_BASE_URL=http://127.0.0.1:8000/v1
COMPANION_MODEL=zhixueban-companion-7b-dpo
COMPANION_API_KEY=EMPTY

# 中间件（本机 Conda / 独立安装，监听 localhost）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeMeNeo4j

MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=zhixueban_chunks
MILVUS_DIM=1024

ES_URL=http://127.0.0.1:9200
ES_INDEX=zhixueban_chunks

EMBED_URL=http://127.0.0.1:8081
RERANK_URL=http://127.0.0.1:8082
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 语音（阿里云 DashScope 示例，可换讯飞/Azure）
DASHSCOPE_API_KEY=
ASR_PROVIDER=dashscope
TTS_PROVIDER=dashscope

CONFIDENCE_THRESHOLD=0.60
API_PORT=8000
